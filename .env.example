# ── Bootstrap only: everything else is configured from the dashboard ──────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales_assistant
# openssl rand -base64 32   (keep it safe: it encrypts the API keys stored in the DB)
ENCRYPTION_KEY=
# openssl rand -hex 32
SESSION_SECRET=
# Public HTTPS URL (ngrok / your domain). Used for the webhook and links in e-mails.
PUBLIC_URL=http://localhost:3000
PORT=3000
# First admin account (created at first boot only)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
LOG_LEVEL=info
